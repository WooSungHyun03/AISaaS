# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets are never committed, but .env.example (no
# secrets, just documented keys) is the team's setup reference and must be.
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# supabase CLI local cache
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts
.env*
