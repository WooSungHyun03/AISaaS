{
  "name": "AutoBiz 9:16 Shorts",
  "tags": ["autobiz", "shorts", "9x16"],
  "movie": {
    "resolution": "custom",
    "width": 1080,
    "height": 1920,
    "quality": "high",
    "variables": {
      "voice_script": "예시 내레이션입니다.",
      "scene_items": [
        {
          "scene_text": "첫 3초에 시선을 잡는 문구",
          "visual_prompt": "브랜드 제품 클로즈업, 세로 9:16",
          "duration_sec": 3,
          "background_color": "#0F172A"
        },
        {
          "scene_text": "문제와 해결 방법을 짧게 설명합니다",
          "visual_prompt": "서비스 사용 장면, 세로 9:16",
          "duration_sec": 12,
          "background_color": "#1E3A8A"
        }
      ]
    },
    "scenes": [
      {
        "iterate": "scene_items",
        "duration": "{{duration_sec}}",
        "background-color": "{{background_color}}",
        "transition": { "type": "xfade", "style": "fade", "duration": 0.3 },
        "elements": [
          {
            "type": "text",
            "text": "{{scene_text}}",
            "duration": -2,
            "position": "custom",
            "x": "10%",
            "y": 480,
            "width": "80%",
            "height": 700,
            "vertical-position": "center",
            "horizontal-position": "center",
            "settings": {
              "font-family": "Noto Sans KR",
              "font-size": "78px",
              "font-weight": "800",
              "line-height": "1.25",
              "text-align": "center",
              "color": "#FFFFFF"
            }
          }
        ]
      }
    ],
    "elements": [
      {
        "type": "voice",
        "text": "{{voice_script}}",
        "model": "azure",
        "voice": "ko-KR-SunHiNeural"
      },
      {
        "type": "subtitles",
        "language": "ko",
        "model": "default",
        "settings": {
          "max-words-per-line": 5,
          "font-size": 64,
          "font-family": "Noto Sans KR",
          "font-weight": "800",
          "position": "custom",
          "x": 540,
          "y": 1520,
          "outline-color": "#000000",
          "outline-width": 6,
          "word-color": "#FACC15",
          "line-color": "#FFFFFF",
          "style": "classic"
        }
      }
    ]
  }
}
