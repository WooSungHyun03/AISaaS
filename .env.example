# ---------------------------------------------------------------------------
# Supabase (required)
# Get these from https://app.supabase.com -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, NEVER exposed to the client. Used for cron
# jobs, webhooks, and admin operations that must bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of this deployment, used for auth redirects and cron callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret required in the `x-cron-secret` header when the scheduler
# (Supabase Edge Function / pg_cron) calls /api/cron/run-automations.
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI provider
# One of: mock | anthropic | openai | gemini
# Production recommendation: anthropic (Claude Haiku 4.5). See docs/AI_SETUP.md.
# "mock" requires no API key and is used for local development / CI.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
# Server-only. Create at https://console.anthropic.com -> API keys. Never expose as NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
# Optional: override the provider's default model id (default for anthropic: claude-haiku-4-5-20251001).
AI_MODEL=
# Per-request timeout and max retry count for the real-provider adapters.
# Retries only apply to transient failures (timeout/429/5xx/network) and are
# always bounded — never infinite. Safe to leave unset (defaults below).
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Billing provider
# One of: mock | toss
# "mock" simulates checkout/webhook/subscription flow with no real charges.
# Toss is intentionally test-mode only for now. Use a billing-enabled test
# merchant key pair from the Toss Payments developer center.
# ---------------------------------------------------------------------------
BILLING_PROVIDER=mock
# Production safety: the mock provider upgrades plans without payment, so it is
# refused when NODE_ENV=production unless this is explicitly "true" (demos only).
ALLOW_MOCK_BILLING=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---------------------------------------------------------------------------
# Platform connectors (optional, feature-gated; leave blank until needed)
# ---------------------------------------------------------------------------
# WordPress (blog automation publishing target)
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
# Required for user-configured WordPress connections. Generate once with
# `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"`.
# Keep this key stable: changing it makes saved connections unreadable.
WORDPRESS_CREDENTIALS_KEY=

# Meta / Instagram (instagram automation)
META_ACCESS_TOKEN=
META_IG_USER_ID=
# User connection OAuth (Instagram Login for Professional accounts)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Add this exact callback in Meta: ${NEXT_PUBLIC_SITE_URL}/api/integrations/instagram/callback

# Resend (newsletter / email automation)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# YouTube (shorts automation)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Add this exact callback in Google Cloud: ${NEXT_PUBLIC_SITE_URL}/api/integrations/youtube/callback

# JSON2Video (shorts rendering)
# One of: mock | json2video. Keep mock for local development and CI.
VIDEO_RENDER_PROVIDER=mock
# Server-only. Create this in the JSON2Video dashboard; never expose it as NEXT_PUBLIC_*.
VIDEO_RENDER_API_KEY=

# Image-to-video service that really animates "character" reference images (docs/ANIMATED_CHARACTERS.md).
# "mock" never calls the network. "fal" needs FAL_KEY from https://fal.ai (prepaid, billed per second of video).
ANIMATION_PROVIDER=mock
FAL_KEY=
# Optional: another fal image-to-video endpoint id (default fal-ai/kling-video/v2.5-turbo/pro/image-to-video).
ANIMATION_MODEL=

# ---------------------------------------------------------------------------
# GitHub (AI Tool Directory metadata sync)
# Optional: raises the unauthenticated GitHub API rate limit (60/hr -> 5000/hr)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Customer Support Chat widget (public, unauthenticated endpoint)
# Required in production — hashes a requester's IP before it's stored for
# rate limiting; never leave unset on a real deployment. Generate once with
# `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"`.
# Safe to leave blank locally: requester-level rate limiting is skipped
# (the per-widget limit still applies) instead of the app failing to boot.
# ---------------------------------------------------------------------------
SUPPORT_WIDGET_IP_HASH_SECRET=

# ---------------------------------------------------------------------------
# Channel diagnosis (src/server/channels) — YouTube/Naver Blog/Tistory
# One of: live | mock. "mock" is refused at server boot in production
# (src/instrumentation.ts) — there is no demo-mode opt-in like
# ALLOW_MOCK_BILLING, since a channel diagnosis score is a number shown
# directly to the user, not a payment simulation.
# ---------------------------------------------------------------------------
CHANNEL_DATA_PROVIDER=mock
# YouTube Data API v3 key (API key only, no OAuth) — console.cloud.google.com
# -> APIs & Services -> Credentials. Enable "YouTube Data API v3" first.
YOUTUBE_API_KEY=
# Naver Search API (blog.json) — developers.naver.com -> Application ->
# register a new app, select "검색" API. Sent as X-Naver-Client-Id/Secret.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
