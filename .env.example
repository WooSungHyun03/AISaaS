# ---------------------------------------------------------------------------
# Supabase (required)
# Get these from https://app.supabase.com -> Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, NEVER exposed to the client. Used for cron
# jobs, webhooks, and admin operations that must bypass Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public URL of this deployment, used for auth redirects and cron callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret required in the `x-cron-secret` header when the scheduler
# (Supabase Edge Function / pg_cron) calls /api/cron/run-automations.
CRON_SECRET=
# ---------------------------------------------------------------------------
# AI provider
# One of: mock | anthropic | openai | gemini
# Production: anthropic. Blog posts and ad Shorts use Claude Opus 5.5 (planner), Fable 5.1 (writer) and
# Sonnet 5.5 (reviewer / vision) by default; every paid call is metered against the budget below. See docs/AI_SETUP.md.
# "mock" requires no API key and is used for local development / CI.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
# Server-only. Create at https://console.anthropic.com -> API keys. Never expose as NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=
# Optional: model id for the small helper features that have no pipeline role (default for anthropic: claude-haiku-4-5-20251001).
AI_MODEL=
# Optional: change a pipeline step's model without a deploy. Unset = Opus 5.5 / Fable 5.1 / Sonnet 5.5 / Sonnet 5.5.
AI_MODEL_PLANNER=
AI_MODEL_WRITER=
AI_MODEL_REVIEWER=
AI_MODEL_VISION=
# One pipeline step can be a single long model call (a whole post from Fable 5.1); how long to wait for it.
AI_LONG_REQUEST_TIMEOUT_MS=240000
# Per-request timeout and max retry count for the real-provider adapters.
# Retries only apply to transient failures (timeout/429/5xx/network) and are
# always bounded — never infinite. Safe to leave unset (defaults below).
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Billing provider
# One of: mock | toss
# "mock" simulates one-time product checkout and credit grants with no charges.
# Toss is intentionally test-mode only for now. Use a payment-enabled test
# merchant key pair from the Toss Payments developer center.
# ---------------------------------------------------------------------------
BILLING_PROVIDER=mock
# Production safety: the mock provider grants credits without payment, so it is
# refused when NODE_ENV=production unless this is explicitly "true" (demos only).
ALLOW_MOCK_BILLING=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# Accepted instead of the line above (the client key is public): TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ---------------------------------------------------------------------------
# Platform connectors (optional, feature-gated; leave blank until needed)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Ad Shorts: Wan 3.0 (fal.ai) + FFmpeg worker + Korean voice (docs/AD_SHORTS.md)
# ---------------------------------------------------------------------------
# One of: mock | fal. "mock" never calls the network and returns a flagged placeholder instead of a video.
AD_VIDEO_PROVIDER=mock
# Server-only. https://fal.ai (prepaid, billed per second of video: 720p $0.10/s, reference video seconds are billed too).
FAL_KEY=
WAN_MODEL=alibaba/wan-3.0/reference-to-video
WAN_ENABLE_PROMPT_EXPANSION=true
WAN_ENABLE_THINKING=true
# fal does not document whether enable_thinking costs extra. Until you have checked an invoice and set this to true,
# each generation is reserved (and booked) at price x WAN_THINKING_RESERVE_MULTIPLIER.
WAN_THINKING_COST_VERIFIED=false
WAN_THINKING_RESERVE_MULTIPLIER=1.5

# The FFmpeg worker (worker/ffmpeg, Docker): probing, quality measurements, logo / CTA overlay, voice mixing, final MP4.
# One of: mock | worker. Set the same POSTPROCESS_WORKER_TOKEN (16+ random characters) here and as WORKER_TOKEN there.
POSTPROCESS_PROVIDER=mock
POSTPROCESS_WORKER_URL=
POSTPROCESS_WORKER_TOKEN=

# Korean narration when the video comes out silent (or the owner chose "한국어 음성 입히기"). One of: mock | elevenlabs.
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
TTS_VOICE_ID=
TTS_MODEL_ID=eleven_multilingual_v2
# Price used to reserve a narration (ElevenLabs lists $0.08 per 1,000 characters; rounded up).
TTS_USD_PER_1K_CHARS=0.1

# ---------------------------------------------------------------------------
# Spend budget (service-wide, enforced in the database: migration 0073)
# Nothing paid runs unless ALLOW_PAID_AI_CALLS=true AND an operating period is set. There is no automatic monthly
# reset: when the period ends, paid generation stops until you set a new one.
# ---------------------------------------------------------------------------
ALLOW_PAID_AI_CALLS=false
# Seoul dates, end excluded. Example: a month starting 2026-11-01.
BUDGET_PERIOD_START=
BUDGET_PERIOD_END=
# Ad videos: total USD, number of videos, the most one video may cost (retries included) and the least one more video
# needs to be finished (held back for every video not made yet, so retries cannot starve the rest).
BUDGET_VIDEO_USD=50
BUDGET_VIDEO_ITEMS=10
BUDGET_VIDEO_ITEM_CAP_USD=10
BUDGET_VIDEO_ITEM_FLOOR_USD=3.5
# Blog posts.
BUDGET_BLOG_USD=20
BUDGET_BLOG_ITEMS=10
BUDGET_BLOG_ITEM_CAP_USD=3
BUDGET_BLOG_ITEM_FLOOR_USD=0.6
# Emergency stop: refuses every paid call without touching the ledger.
BUDGET_FREEZE=false

# ---------------------------------------------------------------------------
# GitHub (AI Tool Directory metadata sync)
# Optional: raises the unauthenticated GitHub API rate limit (60/hr -> 5000/hr)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Customer Support Chat widget (public, unauthenticated endpoint)
# Required in production — hashes a requester's IP before it's stored for
# rate limiting; never leave unset on a real deployment. Generate once with
# `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"`.
# Safe to leave blank locally: requester-level rate limiting is skipped
# (the per-widget limit still applies) instead of the app failing to boot.
# ---------------------------------------------------------------------------
SUPPORT_WIDGET_IP_HASH_SECRET=

# ---------------------------------------------------------------------------
# Channel diagnosis (src/server/channels) — YouTube/Naver Blog/Tistory
# One of: live | mock. "mock" is refused at server boot in production
# (src/instrumentation.ts) — there is no demo-mode opt-in like
# ALLOW_MOCK_BILLING, since a channel diagnosis score is a number shown
# directly to the user, not a payment simulation.
# ---------------------------------------------------------------------------
CHANNEL_DATA_PROVIDER=mock
# Unset defaults to "live" when NODE_ENV=production (and "mock" otherwise); an explicit "mock" in production stops the server at boot.
# YouTube Data API v3 key (API key only, no OAuth) — console.cloud.google.com
# -> APIs & Services -> Credentials. Enable "YouTube Data API v3" first.
YOUTUBE_API_KEY=
# Naver Search API (blog.json) — developers.naver.com -> Application ->
# register a new app, select "검색" API. Sent as X-Naver-Client-Id/Secret.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
